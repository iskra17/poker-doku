# Comma-separated profile IDs allowed to create and operate MTTs from the lobby.
# Backoffice requests authenticated with DEBUG_LOG_TOKEN are always authorized.
TOURNAMENT_OPERATOR_PROFILE_IDS=
# 운영자 모드(로고 7연타 — 보상 미리보기·수련 스킵) 허용 프로필. 비우면 토너먼트 운영자만(운영자 없으면 dev는 전원, production은 없음)
OPERATOR_PROFILE_IDS=
# MTT 공개 로비 노출. true로 바꾼 뒤 재빌드하면 탭·카드·초대 진입을 다시 공개한다.
# 관리자 운영과 서버 토너먼트 처리는 이 UI 플래그와 별개다. Sit & Go는 유지한다.
NEXT_PUBLIC_MTT_ENABLED=false
